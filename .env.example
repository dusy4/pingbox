# ==============================================================================
# PingBox (TriggerApp) - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND - Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=triggerapp
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=triggerapp
DATABASE_URL=postgresql+asyncpg://triggerapp:change-me-to-a-secure-password@db:5432/triggerapp

# ------------------------------------------------------------------------------
# BACKEND - Redis
# ------------------------------------------------------------------------------
REDIS_PASSWORD=change-me-to-a-secure-password
REDIS_URL=redis://:change-me-to-a-secure-password@redis:6379

# ------------------------------------------------------------------------------
# BACKEND - Firebase Cloud Messaging
# ------------------------------------------------------------------------------
# Paste the FULL content of your Firebase service account JSON file below.
# Get it from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# The entire JSON must be on a single line or properly escaped.
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id",...}

# ------------------------------------------------------------------------------
# BACKEND - JWT Authentication
# ------------------------------------------------------------------------------
# Generate a secure random key: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# ------------------------------------------------------------------------------
# BACKEND - CORS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (no spaces between items)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com
